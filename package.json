{
  "name": "sikuwa",
  "version": "0.1.0",
  "description": "SDK multi-gateway WhatsApp untuk JavaScript/TypeScript — satu antarmuka untuk Fonnte, OpenWA, ApiMe, Evolution API, Wuzapi, Wwebjs, dan Waxum. Porting dari paket PHP mdestafadilah/sikuwa, tanpa dependensi runtime.",
  "license": "MIT",
  "author": "mdestafadilah (https://github.com/mdestafadilah)",
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "whatsapp-gateway",
    "sdk",
    "gateway",
    "fonnte",
    "openwa",
    "apime",
    "evolution-api",
    "wuzapi",
    "wwebjs",
    "waxum"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "cloudflare": {
    "label": "BHVR Template",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  },
  "scripts": {
    "build:lib": "bun scripts/build-lib.mjs",
    "prepublishOnly": "bun test && bun run build:lib",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy --env production",
    "dev": "vite",
    "dev:prod": "tsc -b && vite build && wrangler dev --remote",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.lib.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.28.0",
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.167.3",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/router-plugin": "^1.166.12",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "baseline-browser-mapping": "^2.10.8",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "framer-motion": "^12.37.0",
    "globals": "16.5.0",
    "hono": "^4.12.8",
    "ky": "^1.14.3",
    "lucide-react": "^0.577.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^6.4.1",
    "wrangler": "^4.73.0"
  }
}
