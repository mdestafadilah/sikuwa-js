# --- Cloudflare D1 (dipakai worker template) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# --- SIKUWA ---
# Nama kuncinya sama persis dengan versi PHP, jadi berkas .env lama tetap
# terbaca. Semuanya opsional: playground tetap jalan tanpa satu pun diisi.

# Gateway yang dipakai. Salah satu dari:
# Fonnte, OpenWA, ApiMe, EvolutionAPI, Wuzapi, Wwebjs, Waxum.
# `auto` memilih yang tokennya tersedia.
WHATSAPP_PROVIDER=

# Token umum, dan token per gateway. Yang per gateway menang.
WHATSAPP_TOKEN=
WHATSAPP_TOKEN_Fonnte=

# URL dasar. `WHATSAPP_URL_<Provider>` menang atas `WHATSAPP_URL`.
WHATSAPP_URL=
WHATSAPP_URL_OpenWA=

# Id session / instance, untuk gateway self-hosted yang memerlukannya.
WHATSAPP_SESSION=
WHATSAPP_INSTANCE=
WHATSAPP_ACCOUNT_TOKEN=

# Batas waktu satu request, detik.
WHATSAPP_TIMEOUT=

# Jeda antar pesan saat mengirim beruntun: daftar jeda tetap yang dipakai
# bergiliran, interval acak (mis. `20-30`), lalu pengali bila pesannya panjang.
WHATSAPP_PACING_CYCLE=
WHATSAPP_PACING_INTERVAL=
WHATSAPP_PACING_LONG_CHARS=
WHATSAPP_PACING_LONG_FACTOR=

# Indikator "sedang mengetik": menyala atau tidak, kecepatan ketik
# (karakter/detik), serta lama terpendek dan terpanjangnya dalam detik.
WHATSAPP_TYPING=
WHATSAPP_TYPING_SPEED=
WHATSAPP_TYPING_MIN=
WHATSAPP_TYPING_MAX=

# Pembatas laju: berapa pesan boleh keluar per jendela waktu (detik).
WHATSAPP_THROTTLE_MAX=
WHATSAPP_THROTTLE_WINDOW=

# Jumlah percobaan ulang untuk gateway yang mencoba ulang satu per satu.
WHATSAPP_RETRIES=

# Set `false` untuk mematikan notifikasi.
WA_NOTIFICATION=
